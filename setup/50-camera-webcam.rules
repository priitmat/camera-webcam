// Lets local administrators start, stop and restart only camera-webcam.service
// without a password prompt (used by the top bar extension).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "camera-webcam.service" &&
        subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
