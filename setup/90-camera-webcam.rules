# Start the webcam when a camera supported by libgphoto2 is connected.
# Phones and media players (MTP) are skipped.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_GPHOTO2}=="1", ENV{ID_MTP_DEVICE}!="1", ENV{ID_MEDIA_PLAYER}!="1", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/dev/camerawebcam", ENV{SYSTEMD_WANTS}+="camera-webcam.service"
